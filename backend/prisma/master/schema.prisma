// Master DB — faqat platforma (Super Admin) darajasidagi ma'lumotlar.
// Restoranlarning o'z biznes ma'lumotlari (menyu, buyurtma va h.k.) BU YERDA EMAS —
// har bir restoran o'z alohida bazasida saqlanadi (prisma/tenant-template/schema.prisma)

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/master-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DB_URL")
}

enum SubscriptionStatus {
  trial
  active
  suspended
  cancelled
}

enum SubscriptionPlan {
  basic
  standard
  pro
}

enum RestaurantApplicationStatus {
  pending
  approved
  rejected
}

enum BusinessType {
  restaurant
  cafe
}

model SuperAdmin {
  id           String   @id @default(uuid())
  fullName     String
  phone        String   @unique // login: +998901234567 kabi formatda
  email        String? // ixtiyoriy, faqat aloqa uchun
  passwordHash String
  createdAt    DateTime @default(now())
}

// Marketing saytidagi "So'rov yuborish" formasidan keladigan arizalar.
// Super Admin tasdiqlagach — Restaurant yozuvi yaratiladi va provisioning ishga tushadi.
model RestaurantApplication {
  id           String                      @id @default(uuid())
  name         String // restoran/kafe nomi
  businessType BusinessType                @default(restaurant)
  phone        String
  email        String? // ixtiyoriy
  region       String // viloyat
  city         String // shahar/tuman
  description  String? // ixtiyoriy izoh
  plan         SubscriptionPlan            @default(basic)
  status       RestaurantApplicationStatus @default(pending)
  // Tasdiqlangach yaratilgan restoranga havola (audit uchun)
  restaurantId String?
  createdAt    DateTime                    @default(now())
  reviewedAt   DateTime?

  // JAVOB SAYTNING O'ZIDA BERILADI.
  //
  // Ariza egasi natijani bilish uchun saytga Google hisobi bilan kiradi
  // (arizadagi pochta bilan bir xil bo'lishi kerak) va shu yerdan javob
  // oladi. Shuning uchun javob ma'lumotlari shu yozuvda saqlanadi.
  //
  // `adminPasswordEnc` — bir martalik parol, shifrlangan holda (tenant
  // baza parollari bilan bir xil kalit). Egasi bir marta ko'rgach TOZALANADI:
  // parol bazada abadiy yotib qolmasligi kerak.
  adminPasswordEnc  String?
  credentialsSeenAt DateTime?
  // Rad etilgan bo'lsa — qisqa sabab. Bo'sh bo'lsa umumiy matn ko'rsatiladi.
  reviewNote        String?
}

model Restaurant {
  id               String       @id @default(uuid())
  name             String
  slug             String       @unique // subdomain: delish -> delish.bazm.uz
  businessType     BusinessType @default(restaurant)
  logoUrl          String?
  telegramBotToken String?

  // Tenant bazasiga ulanish ma'lumotlari (parol shifrlangan holda saqlanadi!)
  dbName              String
  dbHost              String
  dbPort              Int    @default(5432)
  dbUser              String
  dbPasswordEncrypted String

  subscriptionPlan   SubscriptionPlan   @default(basic)
  subscriptionStatus SubscriptionStatus @default(trial)
  monthlyFee         Decimal            @default(0)

  // BREND — Pro tarifda muassasa o'z rangini tanlaydi.
  // Rang ERKIN emas, tayyor ro'yxatdan (`utils/brand.js`): erkin tanlovda
  // och rang oq fonda o'qilmay qoladi va mijoz o'z ilovasini buzib qo'yadi.
  brandColor       String?
  brandSurface     String?
  brandDisplayFont String?
  brandBodyFont    String?
  nextBillingDate  DateTime?
  // Ortiqcha to'langan pul yo'qolmaydi — keyingi hisobga o'tadi
  creditBalance    Decimal   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingHistory BillingRecord[]
}

// OYLIK HISOB.
//
// Har oy muassasaga bitta hisob ochiladi. To'lov QISMAN kelishi mumkin:
// 300 000 lik hisobga 100 000 tushsa, hisob YOPILMAYDI — qolgan 200 000
// qarz bo'lib turadi va tizim to'lovni so'rayveradi. Pul yo'qolmaydi,
// u `paidAmount` da turadi va ko'rinib turadi.
//
// Hisob to'liq yopilgandagina xizmat yana bir oyga ochiladi.
model BillingRecord {
  id            String     @id @default(uuid())
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId  String
  amount        Decimal
  paidAmount    Decimal    @default(0)
  status        String     @default("pending") // pending | paid | cancelled
  invoiceNumber String
  periodStart   DateTime?
  periodEnd     DateTime?
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime   @default(now())

  payments BillingPayment[]

  @@index([restaurantId, status])
}

// BITTA TO'LOV.
//
// Hisobga tushgan har bir pul alohida yozuv — jami summa emas. Sabab:
// "kim, qachon, qancha to'lagan" degan savolga javob kerak bo'ladi va
// qisman to'lovlar ketma-ketligi ko'rinib turishi shart.
model BillingPayment {
  id        String        @id @default(uuid())
  invoice   BillingRecord @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  amount    Decimal
  // manual — super admin qo'lda tasdiqladi (karta o'tkazmasi va h.k.).
  // Keyinchalik shu yerga payme | click qo'shiladi.
  method    String        @default("manual")
  reference String?
  note      String?
  createdAt DateTime      @default(now())

  @@index([invoiceId])
}

// Yagona login uchun global telefon indeksi.
//
// Xodimlar har bir restoranning O'Z bazasida saqlanadi, shuning uchun
// "bu telefon kimniki?" degan savolga javob berish uchun barcha bazalarni
// birma-bir ochish kerak bo'lardi. Bu jadval shu savolga bitta so'rovda
// javob beradi: telefon -> qaysi restoran.
//
// Parol BU YERDA SAQLANMAYDI — u faqat tenant bazasida qoladi. Bu jadval
// shunchaki yo'l ko'rsatkichi.
//
// Telefon global unikal: bitta odam bir vaqtda faqat bitta restoranda
// ishlaydi. Aks holda login qaysi restoranga kirishni bilmasdi.
model StaffLookup {
  phone          String   @id
  restaurantSlug String
  role           String // admin | kitchen | waiter
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@index([restaurantSlug])
}
