# Bazm backend — muhit sozlamalari namunasi.
# Bu faylni `.env` deb nusxalang va o'z qiymatlaringizni yozing.
# `.env` HECH QACHON git'ga tushmaydi (.gitignore da).

# ---------- Master baza ----------
# Platformaning o'z bazasi: restoranlar ro'yxati, super adminlar, arizalar.
# Har bir restoranning O'Z bazasi alohida yaratiladi (database-per-tenant).
MASTER_DB_URL=postgresql://postgres:PAROL@localhost:5432/bazm_master

# ---------- PostgreSQL server ----------
# Yangi restoran uchun baza yaratishda shu foydalanuvchi ishlatiladi,
# shuning uchun unda CREATE DATABASE huquqi bo'lishi kerak.
PG_HOST=localhost
PG_PORT=5432
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=PAROL

# ---------- Xavfsizlik ----------
# JWT_SECRET — tokenlarni imzolash uchun. Uzun va tasodifiy bo'lsin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=BU_YERGA_UZUN_TASODIFIY_QATOR

# ENCRYPTION_KEY — tenant baza parollarini shifrlash (AES-256-GCM).
# ANIQ 32 BAYT bo'lishi shart (64 ta hex belgi):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=64_TA_HEX_BELGI

# ---------- Server ----------
PORT=4000
NODE_ENV=development

# ---------- Manzillar ----------
# APP_URL — mijoz ilovasi va xodim panellari qayerda turadi.
#
# DIQQAT: Telegram Mini App tugmasi FAQAT https manzil bilan ishlaydi.
# localhost bo'lsa bot havolani matn ko'rinishida beradi (bu normal).
# Sinov uchun: ngrok http 5173  yoki  cloudflared tunnel
APP_URL=http://localhost:5173
PUBLIC_APP_DOMAIN=localhost:5173
MARKETING_URL=http://localhost:3001

# ---------- Telegram ----------
# Har bir restoran o'z botiga ega bo'lishi mumkin (Master DB dagi
# telegramBotToken). Quyidagisi faqat development uchun qo'shimcha bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEV_SLUG=delish

# ---------- QR kod ----------
# web      — QR to'g'ridan-to'g'ri veb-ilovaga olib boradi (har qanday kamera ochadi)
# telegram — QR bot deep-link'iga olib boradi (Telegram talab qilinadi)
QR_TARGET=web

# ---------- Ulanishlar hovuzi ----------
# Har bir muassasa O'Z bazasiga ega, ya'ni har biri alohida hovuz ochadi.
# Cheklanmasa PostgreSQL'ning max_connections (odatda 100) 5-6 muassasadan
# keyin tugaydi. Umumiy tom = TENANT_DB_MAX_CLIENTS * TENANT_DB_POOL.
TENANT_DB_POOL=3
TENANT_DB_MAX_CLIENTS=20
TENANT_DB_POOL_TIMEOUT=20

# ---------- O'z-o'zini tekshirish ----------
# Server kuniga bir-ikki marta vaqtinchalik "kanareyka" muassasa yaratib,
# butun ish oqimini sinab ko'radi va uni bazasi bilan o'chiradi.
# Haqiqiy muassasalarga tegmaydi va panelda ko'rinmaydi.
# Natijani ko'rish: GET /api/health/selftest (super admin tokeni bilan)
SELFTEST_ENABLED=true
SELFTEST_INTERVAL_HOURS=12
SELFTEST_FIRST_DELAY_SEC=90
